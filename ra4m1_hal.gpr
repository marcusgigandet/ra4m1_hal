with "config/ra4m1_hal_config.gpr";
project RA4M1_HAL is

   for Source_Dirs use
     ("src/", "src/generated/r7fa4m1ab/", "config/");
   for Object_Dir use "obj/" & RA4M1_HAL_Config.Build_Profile;
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        RA4M1_HAL_Config.Ada_Compiler_Switches &
        ("-mcpu=cortex-m4", "-mthumb", "-mfloat-abi=soft");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end RA4M1_HAL;
